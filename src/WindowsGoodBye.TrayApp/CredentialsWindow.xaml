<Window x:Class="WindowsGoodBye.TrayApp.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource GlassWindow}"
        Title="WindowsGoodBye — Credenciales de Windows"
        Width="420" Height="460">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Style="{DynamicResource Blob}" Width="190" Height="190" Canvas.Left="-50" Canvas.Top="-50" Fill="{DynamicResource CyanBrush}" />
            <Ellipse Style="{DynamicResource Blob}" Width="160" Height="160" Canvas.Left="250" Canvas.Top="320" Fill="{DynamicResource GreenBrush}" />
        </Canvas>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Credenciales de Windows" Style="{DynamicResource HeadingText}" />
                <TextBlock Style="{DynamicResource BodyText}" Margin="0,6,0,0"
                           Text="Tu contrasena de Windows se guarda cifrada localmente (DPAPI) y el Credential Provider la usa para desbloquear la PC cuando tu telefono autentica." />
            </StackPanel>

            <Border Grid.Row="1" Style="{DynamicResource GlassPanel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="DOMINIO" Style="{DynamicResource FieldLabelText}" />
                    <TextBox x:Name="txtDomain" Style="{DynamicResource GlassTextBox}" Margin="0,0,0,12" />

                    <TextBlock Text="USUARIO" Style="{DynamicResource FieldLabelText}" />
                    <TextBox x:Name="txtUsername" Style="{DynamicResource GlassTextBox}" Margin="0,0,0,12" />

                    <TextBlock Text="CONTRASENA" Style="{DynamicResource FieldLabelText}" />
                    <PasswordBox x:Name="txtPassword" Style="{DynamicResource GlassPasswordBox}" />
                </StackPanel>
            </Border>

            <Button Grid.Row="2" Style="{DynamicResource PrimaryButton}" Content="Guardar credenciales"
                    Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="OnSaveClicked" />
        </Grid>
    </Grid>
</Window>
